<?xml version="1.0" encoding="UTF-8"?>
<!--
  SSH で繋がらないマシン側に置く定義 (drop モード)。
  1 時間ごとに、自分の run 一覧と完遂モデルを共有フォルダへ書き出すだけ。
  Notion にも外部にも接続しない。集約側の Mac がそのフォルダを読む。

  置き換えるのは machine の値だけ (例: 黒 / MacB)。
  スクリプトはリポジトリのものを直接使うので、git pull すれば更新される。
  パスは ~ のままでよい (sh が展開するのでユーザー名に依存しない)。

    cp tools/com.ldrp.export-runs.plist ~/Library/LaunchAgents/
    vi ~/Library/LaunchAgents/com.ldrp.export-runs.plist   # machine を書き換える
    launchctl load ~/Library/LaunchAgents/com.ldrp.export-runs.plist
    launchctl start com.ldrp.export-runs
    tail -f /tmp/ldrp_export.log

  止めるとき: launchctl unload ~/Library/LaunchAgents/com.ldrp.export-runs.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ldrp.export-runs</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>python3 ~/LDRP/tools/collect_runs.py --export ~/Library/Mobile\ Documents/com~apple~CloudDocs/LDRP_runs --machine 黒 --repo ~/LDRP</string>
  </array>

  <!-- 3600 秒 = 1 時間ごと -->
  <!-- 900 秒 = 15 分ごと。集約側 (白) の収集間隔と揃えてある。
       runs.jsonl (数百 KB) は毎回書き直すが、モデルは既に共有フォルダに
       あるものを飛ばすので、2 回目以降はほぼ走査だけ (実測 0.4 秒)。
       進捗ファイルはモデル転送より先に書くので、iCloud のアップロードが
       詰まっても進捗だけは最新になる -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>

  <key>StandardOutPath</key><string>/tmp/ldrp_export.log</string>
  <key>StandardErrorPath</key><string>/tmp/ldrp_export.log</string>
</dict>
</plist>
